{
  "name": "pouchpay-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run db:generate && rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:status": "node scripts/prisma-db.cjs status",
    "db:migrate:deploy": "node scripts/prisma-db.cjs deploy",
    "db:local:start": "node scripts/local-db.cjs start",
    "db:local:stop": "node scripts/local-db.cjs stop",
    "db:local:status": "node scripts/local-db.cjs status",
    "db:local:check": "node scripts/local-db.cjs check",
    "db:local:generate": "node scripts/local-db.cjs generate",
    "db:local:validate": "node scripts/local-db.cjs validate",
    "db:local:migrate": "node scripts/local-db.cjs migrate",
    "db:local:migration:create": "node scripts/local-db.cjs create-migration",
    "start:local": "node scripts/local-db.cjs serve"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "@nestjs/config": "3.3.0",
    "dotenv": "^16.4.0",
    "ethers": "6.17.0",
    "prisma": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.43",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|f)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|f)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
